{
  "name": "cua-lark",
  "version": "0.1.0",
  "private": true,
  "description": "CUA-Lark UI-TARS GUIAgent based desktop testing harness for Feishu/Lark.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/doctor.ts",
    "task": "tsx src/index.ts task",
    "task:gui": "tsx src/index.ts task:gui",
    "task:inbox": "tsx src/index.ts task:inbox",
    "demo:vc": "tsx src/index.ts demo:vc",
    "demo:im": "tsx src/index.ts demo:im",
    "demo:docs": "tsx src/index.ts demo:docs",
    "demo:calendar": "tsx src/index.ts demo:calendar",
    "demo:cross": "tsx src/index.ts demo:cross",
    "demo:gui:vc": "tsx src/index.ts demo:gui:vc",
    "eval": "tsx src/eval/index.ts online",
    "eval:nl": "tsx src/eval/natural-language.ts",
    "eval:offline": "tsx src/eval/index.ts offline",
    "eval:all": "tsx src/eval/run-all.ts",
    "eval:ui": "tsx src/eval/ui-server.ts"
  },
  "dependencies": {
    "@ui-tars/operator-nut-js": "^1.2.3",
    "@ui-tars/sdk": "^1.2.3",
    "dotenv": "^16.4.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4"
}
