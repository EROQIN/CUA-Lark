# UI-TARS GUIAgent model config. OpenAI-compatible Chat Completions endpoint.
UI_TARS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UI_TARS_API_KEY=your_api_key_here
UI_TARS_MODEL=qwen3.6-plus

# Optional fallback. Used only when UI_TARS_* is not set.
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL=gpt-4o
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=2048

# Run output.
CUA_LARK_RUNS_DIR=runs

# Comma-separated macOS app names to activate before running a task.
CUA_LARK_TARGET_APP=飞书,Lark
CUA_LARK_ACTIVATION_DELAY_MS=1000

# Task defaults.
TASK_PRODUCT=auto
TASK_MAX_TURNS=12
TASK_STEP_DELAY_MS=800
TASK_GROUP_NAME=测试群
TASK_SEND_REAL_MESSAGE=true

# Optional comma-separated operation context IDs.
# Example: global-command-search,vc-home-schedule-meeting
TASK_CONTEXT_IDS=

# M4 evaluation defaults.
EVAL_CASE_SET=eval/cases/m4-smoke.json
EVAL_MODE=online
EVAL_OUTPUT_DIR=runs/evaluations
EVAL_VLM_VERIFY=false
EVAL_MAX_CASES=
EVAL_STOP_ON_FAILURE=false
