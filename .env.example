# Optional. Used later when CUALarkAgent delegates planning to UI-TARS GUIAgent.
UI_TARS_BASE_URL=
UI_TARS_API_KEY=
UI_TARS_MODEL=

# Directory for reports and screenshots.
CUA_LARK_RUNS_DIR=runs

# Comma-separated macOS app names to activate before running a scenario.
# Use "飞书" for the China client, or "Lark" for the international client.
CUA_LARK_TARGET_APP=飞书,Lark
CUA_LARK_ACTIVATION_DELAY_MS=1000

# Set to false if you want screenshot failures to surface instead of using macOS screencapture fallback.
CUA_LARK_SCREENSHOT_FALLBACK=true

# Set to false if you want action failures to surface instead of using macOS osascript fallback.
CUA_LARK_ACTION_FALLBACK=true

# Prefer @ui-tars/operator-nut-js for actions before falling back to macOS osascript.
CUA_LARK_PREFER_UI_TARS_EXECUTE=true

# M1.5 VLM grounding. Supports OpenAI-compatible Chat Completions vision APIs.
VLM_PROVIDER=openai-compatible
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=your_api_key_here
VLM_MODEL=gpt-4o
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=1024
VLM_TIMEOUT_MS=60000
VLM_MAX_RETRIES=1

# M2 IM free-planner demo.
M2_MAX_TURNS=12
M2_STEP_DELAY_MS=800
M2_GROUP_NAME=测试群
M2_SEND_REAL_MESSAGE=true
