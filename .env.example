# UI-TARS GUIAgent model config. OpenAI-compatible Chat Completions endpoint.
UI_TARS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UI_TARS_API_KEY=your_api_key_here
UI_TARS_MODEL=qwen3.6-plus

# Optional fallback. Used only when UI_TARS_* is not set.
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL=gpt-4o
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=2048

# Run output.
CUA_LARK_RUNS_DIR=runs

# Comma-separated macOS app names to activate before running a task.
CUA_LARK_TARGET_APP=飞书,Lark
CUA_LARK_ACTIVATION_DELAY_MS=1000

# Desktop notifications. macOS uses Notification Center; other platforms emit a terminal bell.
CUA_LARK_NOTIFY_TASK_COMPLETE=true
CUA_LARK_NOTIFY_EVAL_COMPLETE=true
CUA_LARK_NOTIFY_SOUND=Glass
CUA_LARK_COMPLETION_DIALOG=true
CUA_LARK_COMPLETION_DIALOG_TIMEOUT_SEC=10
CUA_LARK_OPEN_TASK_REPORT_UI=true

# Task defaults.
TASK_PRODUCT=auto
TASK_MAX_TURNS=12
TASK_STEP_DELAY_MS=800
TASK_GROUP_NAME=测试群
TASK_INBOX_GROUP_NAME=任务群
TASK_STATUS_MESSAGE_PREFIX=CUA-Lark
TASK_AUTO_REPLY_STATUS=true
TASK_SELF_HEAL_RETRIES=1
TASK_SEND_REAL_MESSAGE=true

# Optional comma-separated operation context IDs.
# Example: global-command-search,vc-home-schedule-meeting
TASK_CONTEXT_IDS=

# M4 evaluation defaults.
# Edit eval/cases/m4-smoke.json to change the default evaluation tasks.
EVAL_CASE_SET=eval/cases/m4-smoke.json
EVAL_MODE=online
EVAL_OUTPUT_DIR=runs/evaluations
EVAL_VLM_VERIFY=false
EVAL_MAX_CASES=
EVAL_CASE_IDS=
EVAL_STOP_ON_FAILURE=false
EVAL_UI_PORT=4317
EVAL_UI_OPEN=true

# Ad-hoc natural language evaluation.
EVAL_NL_TITLE=自然语言临时测试
EVAL_NL_REQUIRED_TEXTS=
EVAL_NL_REQUIRED_ACTION_TYPES=finished
EVAL_NL_FORBIDDEN_TEXTS=
EVAL_NL_MAX_DURATION_MS=300000
EVAL_NL_MAX_TURNS=
EVAL_NL_STEP_DELAY_MS=
EVAL_NL_CONTEXT_IDS=
